# 所有配置项统一使用 LOWFREQ_ 前缀
LOWFREQ_DATA_DIR=./data
# 留空则使用 data/lowfreq.db (SQLite)；切换到 PostgreSQL 时填写完整 DSN
LOWFREQ_DATABASE_URL=
LOWFREQ_MAX_UPLOAD_MB=500
# 内网共享口令：留空表示不鉴权；设置后 HTTP 与 WebSocket 都需要携带
# 前端在「隐私与校准」页填写口令与操作人（保存在浏览器 localStorage）
LOWFREQ_ACCESS_TOKEN=
# 单个音频参与离线分析的时长上限（秒）：0 表示不限制
# 默认 600 s 用于约束解码与频谱计算的内存峰值；低频测量通常远短于此
LOWFREQ_ANALYSIS_MAX_SECONDS=600
LOWFREQ_ALLOWED_EXTENSIONS=.wav,.flac,.ogg,.mp3
LOWFREQ_CORS_ORIGINS=http://localhost:5173
# 未校准麦克风时保留 0；接入校准档案后填入灵敏度对应的修正量
LOWFREQ_DEFAULT_CALIBRATION_OFFSET_DB=0
# 单机分析线程数；SQLite 下建议保持 1，避免并发写锁
LOWFREQ_ANALYSIS_WORKERS=1
# 音频保留天数：0 表示不自动清理；建议内网部署设为 30（7/30/90 可选）
# 已关联事件的音频视为证据，不会被自动删除
LOWFREQ_AUDIO_RETENTION_DAYS=0
LOWFREQ_RETENTION_SWEEP_HOURS=24
LOWFREQ_DISK_WARN_PERCENT=85
# LLM 辅助解读：兼容 OpenAI Chat Completions 协议的云厂商或内网网关
# 默认关闭；填写 BASE_URL / API_KEY / MODEL 后才允许调用
LOWFREQ_LLM_ENABLED=false
# 例：https://api.deepseek.com/v1 或 https://dashscope.aliyuncs.com/compatible-mode/v1
LOWFREQ_LLM_BASE_URL=
LOWFREQ_LLM_API_KEY=
LOWFREQ_LLM_MODEL=
LOWFREQ_LLM_TIMEOUT_S=60
LOWFREQ_LLM_MAX_TOKENS=1500
# 分析成功后自动生成 AI 解读（默认关闭，也可在分析页手动生成）
LOWFREQ_LLM_AUTO_INSIGHT=false
